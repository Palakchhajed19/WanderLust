<% layout("layouts/boilerplate") %>
 <div class="row">
    <div class="col-8 offset-2">
       <br><br> 
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings">
        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name ="listing[title]" placeholder="Enter title" type="text" class="form-control">
        </div>
        <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name ="listing[description]" class="form-control" ></textarea>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Image link</label>
        <input name ="listing[image]" placeholder="Enter Image URL/Links" type="text" class="form-control">
       </div>

       <div class="row">
      <div class="md:col-4">
       <label for="price" class="form-label">Price</label>
        <input name ="listing[price]" placeholder="1200" type="number" class="form-control">
        </div>
         <div class="md:col-8">
        <label for="country" class="form-label">Country</label>
        <input name ="listing[country]" placeholder="India" type="text" class="form-control">
        </div>
        </div>
        <div class="mb-3">
        <label for="loaction" class="form-label">Loaction</label>
        <input name ="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control">
        </div>
        <br>
        <button type="submit" class="btn-solid theme-inverse add-btn">Add</button>
        <br><br>
    </form>
    <br>
</div>
    </div>
